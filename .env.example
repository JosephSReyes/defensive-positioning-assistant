# Defensive Positioning Assistant — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to version control.
# Set these same variables in Netlify → Site Settings → Environment Variables.
#
# All secrets below are used ONLY in Netlify Functions (server-side).
# They are never exposed to frontend JavaScript.
# -------------------------------------------------------

# OpenAI API key — used by netlify/functions/openai-roster-import.js
# and netlify/functions/ai-coach-brief.js
OPENAI_API_KEY=your_openai_api_key_here

# Stripe is handled entirely by Memberstack (see Memberstack dashboard → Stripe connection).
# No Stripe API keys are required here — Memberstack manages billing server-side.

# Memberstack public key — used for frontend Memberstack SDK initialization.
# This is the PUBLIC key (safe for frontend use), not the secret API key.
MEMBERSTACK_PUBLIC_KEY=your_memberstack_public_key_here
